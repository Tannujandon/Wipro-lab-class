
import SwiftUI

@main
struct RegistrationUITestApp: App {
    var body: some Scene {
        WindowGroup {
            ContentView()
        }
    }
}

struct ContentView: View {

    @State private var name = ""
    @State private var email = ""
    @State private var errorMessage = ""
    @State private var showSuccess = false

    private var isValid: Bool {
        let trimmedName = name.trimmingCharacters(
            in: .whitespacesAndNewlines
        )

        let trimmedEmail = email.trimmingCharacters(
            in: .whitespacesAndNewlines
        )

        let emailPattern =
            #"^[A-Z0-9a-z._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"#

        let validEmail = trimmedEmail.range(
            of: emailPattern,
            options: .regularExpression
        ) != nil

        return trimmedName.count >= 2 && validEmail
    }

    var body: some View {
        NavigationStack {
            Form {
                Section("Student Details") {

                    TextField("Enter your name", text: $name)
                        .accessibilityIdentifier("nameField")

                    TextField("Enter your email", text: $email)
                        .keyboardType(.emailAddress)
                        .textInputAutocapitalization(.never)
                        .autocorrectionDisabled()
                        .accessibilityIdentifier("emailField")
                }

                if !errorMessage.isEmpty {
                    Text(errorMessage)
                        .foregroundStyle(.red)
                        .accessibilityIdentifier("errorMessage")
                }

                Section {
                    Button("Submit Registration") {
                        submitForm()
                    }
                    .accessibilityIdentifier("submitButton")
                }
            }
            .navigationTitle("Student Registration")
            .alert("Registration Successful", isPresented: $showSuccess) {
                Button("OK", role: .cancel) { }
                    .accessibilityIdentifier("successOKButton")
            } message: {
                Text("Welcome, \(name)! Your registration is complete.")
                    .accessibilityIdentifier("successMessage")
            }
        }
    }

    private func submitForm() {
        if !isValid {
            errorMessage = "Please enter a valid name and email."
            showSuccess = false
            return
        }

        errorMessage = ""
        showSuccess = true
    }
}
