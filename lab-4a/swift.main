
import SwiftUI
import UIKit
import Combine

// MARK: - Shared Model

struct TaskItem: Identifiable {
    let id: UUID
    var title: String
    var isCompleted: Bool

    init(title: String, isCompleted: Bool = false) {
        self.id = UUID()
        self.title = title
        self.isCompleted = isCompleted
    }
}

enum TaskFilter: String, CaseIterable {
    case all = "All"
    case pending = "Pending"
    case completed = "Completed"
}

// MARK: - R2: MVC MODEL

class TaskListModel {
    private(set) var tasks: [TaskItem] = []

    func addTask(title: String) -> Bool {
        let cleanedTitle = title.trimmingCharacters(in: .whitespacesAndNewlines)

        guard !cleanedTitle.isEmpty else {
            return false
        }

        tasks.append(TaskItem(title: cleanedTitle))
        return true
    }

    func toggleTask(at index: Int) {
        guard tasks.indices.contains(index) else { return }
        tasks[index].isCompleted.toggle()
    }

    func deleteTask(at index: Int) {
        guard tasks.indices.contains(index) else { return }
        tasks.remove(at: index)
    }

    func filteredTasks(using filter: TaskFilter) -> [TaskItem] {
        switch filter {
        case .all:
            return tasks
        case .pending:
            return tasks.filter { !$0.isCompleted }
        case .completed:
            return tasks.filter { $0.isCompleted }
        }
    }
}

// MARK: - R2: MVC VIEW

class TaskListMVCView: UIView {
    let titleField = UITextField()
    let addButton = UIButton(type: .system)
    let filterControl = UISegmentedControl(items: ["All", "Pending", "Completed"])
    let tableView = UITableView()

    var onAdd: ((String) -> Void)?
    var onFilter: ((TaskFilter) -> Void)?

    override init(frame: CGRect) {
        super.init(frame: frame)
        setupUI()
    }

    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    private func setupUI() {
        backgroundColor = .systemBackground

        titleField.placeholder = "Enter a task"
        titleField.borderStyle = .roundedRect

        addButton.setTitle("Add Task", for: .normal)
        filterControl.selectedSegmentIndex = 0

        let stack = UIStackView(arrangedSubviews: [
            titleField, addButton, filterControl, tableView
        ])

        stack.axis = .vertical
        stack.spacing = 12
        stack.translatesAutoresizingMaskIntoConstraints = false

        addSubview(stack)

        NSLayoutConstraint.activate([
            stack.topAnchor.constraint(
                equalTo: safeAreaLayoutGuide.topAnchor,
                constant: 20
            ),
            stack.leadingAnchor.constraint(
                equalTo: leadingAnchor,
                constant: 16
            ),
            stack.trailingAnchor.constraint(
                equalTo: trailingAnchor,
                constant: -16
            ),
            stack.bottomAnchor.constraint(
                equalTo: safeAreaLayoutGuide.bottomAnchor,
                constant: -10
            ),
            titleField.heightAnchor.constraint(equalToConstant: 40),
            addButton.heightAnchor.constraint(equalToConstant: 40),
            filterControl.heightAnchor.constraint(equalToConstant: 35)
        ])

        addButton.addTarget(
            self,
            action: #selector(addButtonTapped),
            for: .touchUpInside
        )

        filterControl.addTarget(
            self,
            action: #selector(filterChanged),
            for: .valueChanged
        )
    }

    @objc private func addButtonTapped() {
        onAdd?(titleField.text ?? "")
    }

    @objc private func filterChanged() {
        let filters: [TaskFilter] = [.all, .pending, .completed]
        onFilter?(filters[filterControl.selectedSegmentIndex])
    }

    func clearInput() {
        titleField.text = ""
    }
}

// MARK: - R2: MVC CONTROLLER

class TaskListMVCViewController: UIViewController,
                                 UITableViewDataSource,
                                 UITableViewDelegate {

    private let model = TaskListModel()
    private let taskView = TaskListMVCView()

    private var selectedFilter: TaskFilter = .all

    private var visibleTasks: [TaskItem] {
        model.filteredTasks(using: selectedFilter)
    }

    override func loadView() {
        view = taskView
    }

    override func viewDidLoad() {
        super.viewDidLoad()

        title = "MVC Task List"
        taskView.tableView.dataSource = self
        taskView.tableView.delegate = self
        taskView.tableView.register(
            UITableViewCell.self,
            forCellReuseIdentifier: "TaskCell"
        )

        taskView.onAdd = { [weak self] title in
            guard let self = self else { return }

            if self.model.addTask(title: title) {
                self.taskView.clearInput()
                self.taskView.tableView.reloadData()
            } else {
                self.showMessage("Please enter a task.")
            }
        }

        taskView.onFilter = { [weak self] filter in
            self?.selectedFilter = filter
            self?.taskView.tableView.reloadData()
        }
    }

    func tableView(
        _ tableView: UITableView,
        numberOfRowsInSection section: Int
    ) -> Int {
        return visibleTasks.count
    }

    func tableView(
        _ tableView: UITableView,
        cellForRowAt indexPath: IndexPath
    ) -> UITableViewCell {
        let cell = tableView.dequeueReusableCell(
            withIdentifier: "TaskCell",
            for: indexPath
        )

        let task = visibleTasks[indexPath.row]
        cell.textLabel?.text = task.title
        cell.accessoryType = task.isCompleted ? .checkmark : .none
        cell.textLabel?.textColor =
            task.isCompleted ? .secondaryLabel : .label

        return cell
    }

    func tableView(
        _ tableView: UITableView,
        didSelectRowAt indexPath: IndexPath
    ) {
        // Toggle completion in the model.
        let selectedTask = visibleTasks[indexPath.row]

        if let originalIndex = model.tasks.firstIndex(
            where: { $0.id == selectedTask.id }
        ) {
            model.toggleTask(at: originalIndex)
        }

        tableView.reloadData()
    }

    func tableView(
        _ tableView: UITableView,
        commit editingStyle: UITableViewCell.EditingStyle,
        forRowAt indexPath: IndexPath
    ) {
        guard editingStyle == .delete else { return }

        let selectedTask = visibleTasks[indexPath.row]

        if let originalIndex = model.tasks.firstIndex(
            where: { $0.id == selectedTask.id }
        ) {
            model.deleteTask(at: originalIndex)
        }

        tableView.reloadData()
    }

    private func showMessage(_ message: String) {
        let alert = UIAlertController(
            title: "Task List",
            message: message,
            preferredStyle: .alert
        )

        alert.addAction(UIAlertAction(title: "OK", style: .default))
        present(alert, animated: true)
    }
}

// MARK: - R3 and R4: MVVM VIEW MODEL

class TaskViewModel: ObservableObject {
    @Published private(set) var tasks: [TaskItem] = []
    @Published var filter: TaskFilter = .all

    var filteredTasks: [TaskItem] {
        switch filter {
        case .all:
            return tasks
        case .pending:
            return tasks.filter { !$0.isCompleted }
        case .completed:
            return tasks.filter { $0.isCompleted }
        }
    }

    @Published var errorMessage: String?

    func addTask(title: String) {
        let cleanedTitle = title.trimmingCharacters(
            in: .whitespacesAndNewlines
        )

        guard !cleanedTitle.isEmpty else {
            errorMessage = "Please enter a task."
            return
        }

        tasks.append(TaskItem(title: cleanedTitle))
        errorMessage = nil
    }

    func toggleTask(_ task: TaskItem) {
        guard let index = tasks.firstIndex(
            where: { $0.id == task.id }
        ) else {
            return
        }

        tasks[index].isCompleted.toggle()
    }

    func deleteTask(_ task: TaskItem) {
        tasks.removeAll { $0.id == task.id }
    }
}

// MARK: - R3: MVVM SWIFTUI VIEW

struct MVVMTaskListView: View {
    @StateObject private var viewModel = TaskViewModel()
    @State private var newTask = ""

    var body: some View {
        NavigationStack {
            VStack(spacing: 15) {

                HStack {
                    TextField("Enter a task", text: $newTask)
                        .textFieldStyle(.roundedBorder)

                    Button("Add") {
                        viewModel.addTask(title: newTask)
                        if viewModel.errorMessage == nil {
                            newTask = ""
                        }
                    }
                    .buttonStyle(.borderedProminent)
                }
                .padding(.horizontal)

                Picker("Filter", selection: $viewModel.filter) {
                    ForEach(TaskFilter.allCases, id: \.self) { filter in
                        Text(filter.rawValue).tag(filter)
                    }
                }
                .pickerStyle(.segmented)
                .padding(.horizontal)

                if let message = viewModel.errorMessage {
                    Text(message)
                        .foregroundStyle(.red)
                }

                List {
                    ForEach(viewModel.filteredTasks) { task in
                        HStack {
                            Button {
                                viewModel.toggleTask(task)
                            } label: {
                                Image(
                                    systemName: task.isCompleted
                                    ? "checkmark.circle.fill"
                                    : "circle"
                                )
                            }
                            .buttonStyle(.plain)

                            Text(task.title)
                                .strikethrough(task.isCompleted)
                                .foregroundStyle(
                                    task.isCompleted ? .secondary : .primary
                                )

                            Spacer()

                            Button(role: .destructive) {
                                viewModel.deleteTask(task)
                            } label: {
                                Image(systemName: "trash")
                            }
                        }
                    }
                }
            }
            .navigationTitle("MVVM Task List")
        }
    }
}

// MARK: - Optional UIKit-to-SwiftUI bridge

struct MVCContainer: UIViewControllerRepresentable {
    func makeUIViewController(
        context: Context
    ) -> TaskListMVCViewController {
        return TaskListMVCViewController()
    }

    func updateUIViewController(
        _ controller: TaskListMVCViewController,
        context: Context
    ) {}
}

// Use MVVMTaskListView() as the app's starting screen.
// To run the MVC version, use MVCContainer() instead.
